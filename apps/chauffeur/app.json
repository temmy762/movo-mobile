{
  "expo": {
    "name": "Movo Chauffeur",
    "slug": "movo-chauffeur",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.movoprive.chauffeur"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#131936",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.movoprive.chauffeur"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "movochauffeur",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-font",
      "expo-splash-screen",
      "expo-image",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Movo Chauffeur uses your location to send you nearby ride requests and to guide you to your rider.",
          "locationAlwaysAndWhenInUsePermission": "While you're online, Movo Chauffeur shares your location in the background so riders see you arriving and you keep receiving nearby ride requests. It stops when you go offline.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
